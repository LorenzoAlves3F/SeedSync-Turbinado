# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JWT (used for auth token verification — same key as frontend VITE_JWT_PUBLIC_KEY)
VITE_JWT_PUBLIC_KEY=

# Google Sheets (used by API for sheet column introspection)
# Local dev: path to the JSON key file (relative to api/)
GOOGLE_SERVICE_ACCOUNT_PATH=../worker/google-service-account.json
# Cloud deploy: paste the full JSON contents as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=

# CORS — comma-separated allowed origins; must be set explicitly in production
CORS_ORIGINS=http://localhost:5173
