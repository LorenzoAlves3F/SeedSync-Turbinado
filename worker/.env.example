# ── SeedSync Environment Configuration ──────────────────────────────────────

# ── SUPABASE
# Found in Supabase Settings > API
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share-this

# ── GOOGLE SHEETS
# Local dev: path to the JSON key file (relative to worker/)
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json
# Cloud deploy: paste the full JSON contents as a single-line string (takes priority over PATH)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── WHATSAPP (Z-API)
# Found in Z-API Dashboard
ZAPI_INSTANCE_ID=your-instance-id
ZAPI_TOKEN=your-token
ZAPI_CLIENT_TOKEN=your-client-token

# ── OPTIONAL CONFIGS
# Interval between ingestion sweeps
POLL_INTERVAL_SECONDS=120
# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# If true, worker will log but NOT post to Supabase or send WhatsApp
DRY_RUN=false
# If set, ALL WhatsApp notifications will go to these phones instead of lead destinations (for testing/pilot)
# Multiple numbers can be separated by commas
NOTIFY_OVERRIDE_PHONE=

# Health server port (used by 3F Orchestrator to verify worker is running)
WORKER_HEALTH_PORT=9000
